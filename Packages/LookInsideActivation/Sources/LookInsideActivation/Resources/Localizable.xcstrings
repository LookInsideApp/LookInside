    "Each Mac can only use the trial once. Activate a license to continue." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لكل Mac استخدام الفترة التجريبية مرة واحدة فقط. فعّل ترخيصًا للمتابعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Mac kann die Testversion nur einmal nutzen. Aktiviere eine Lizenz, um fortzufahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each Mac can only use the trial once. Activate a license to continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada Mac solo puede usar la prueba una vez. Activa una licencia para continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque Mac ne peut utiliser l’essai qu’une seule fois. Activez une licence pour continuer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni Mac può usare la prova una sola volta. Attiva una licenza per continuare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試用版は1台のMacにつき1回のみ使用できます。続けるには、ライセンスをアクティベートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 한 대당 체험판은 한 번만 사용할 수 있습니다. 계속하려면 라이선스를 활성화하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada Mac pode usar o teste apenas uma vez. Ative uma licença para continuar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый Mac может использовать пробный период только один раз. Активируйте лицензию, чтобы продолжить."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi Mac chỉ được dùng thử một lần. Hãy kích hoạt giấy phép để tiếp tục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每台 Mac 仅可使用一次试用。请激活许可证以继续使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每部 Mac 只能試用一次。請啟用授權以繼續使用。"
          }
        }
      }
    },
