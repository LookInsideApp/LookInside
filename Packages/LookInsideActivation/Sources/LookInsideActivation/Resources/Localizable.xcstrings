        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS pede acesso às chaves toda vez que o LookInside se conecta a um app. Escolha “Sempre Permitir” para parar esses pedidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS запрашивает доступ к связке ключей при каждом подключении LookInside к приложению. Выберите «Всегда разрешать», чтобы запросы прекратились."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hỏi quyền truy cập chuỗi khóa mỗi lần LookInside kết nối với một ứng dụng. Hãy chọn “Luôn cho phép” để dừng các yêu cầu này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次 LookInside 连接 App 时，macOS 都会请求钥匙串访问权限。选择“始终允许”即可不再询问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次 LookInside 連接 App 時，macOS 都會要求存取鑰匙圈。選擇「一律允許」即可不再詢問。"
          }
        }
      }
    },
