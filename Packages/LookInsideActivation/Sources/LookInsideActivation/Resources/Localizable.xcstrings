      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Subscription · Refunded" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "订阅 · 已退款" } }
      }
    },
    "Trial Already Used" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Trial Already Used" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "本机已用过试用" } }
      }
    },
    "Each Mac can only use the trial once. Activate a license to continue." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Each Mac can only use the trial once. Activate a license to continue." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "每台 Mac 仅可使用一次试用。请激活正式版以继续使用。" } }
      }
    },
    "Allow Access to Your License Key" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow Access to Your License Key" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "允许访问许可证密钥" } }
      }
    },
    "LookInside needs to use the license key saved when you activated. macOS will ask for keychain access next. Choose “Always Allow”, otherwise you will be asked again every time LookInside connects to an app." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "LookInside needs to use the license key saved when you activated. macOS will ask for keychain access next. Choose “Always Allow”, otherwise you will be asked again every time LookInside connects to an app." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "LookInside 需要使用激活时保存的许可证密钥。接下来 macOS 会请求钥匙串访问权限，请选择“始终允许”，否则每次 LookInside 连接 App 时都会再次询问。" } }
      }
    },
    "Not Now" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Not Now" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "以后再说" } }
      }
    },
    "Continue" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Continue" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "继续" } }
      }
    },
    "LookInside won’t use the license key until you continue, so Pro features are paused. Click Try Again when you’re ready." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "LookInside won’t use the license key until you continue, so Pro features are paused. Click Try Again when you’re ready." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在你继续之前，LookInside 不会使用许可证密钥，Pro 功能已暂停。准备好后请点按“重试”。" } }
      }
    },
    "macOS asks for keychain access each time LookInside connects to an app. Choose “Always Allow” to stop these requests." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS asks for keychain access each time LookInside connects to an app. Choose “Always Allow” to stop these requests." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "每次 LookInside 连接 App 时，macOS 都会请求钥匙串访问权限。选择“始终允许”即可不再询问。" } }
      }
    }
