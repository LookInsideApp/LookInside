    "A new certificate will not be issued after expiry because this purchase was refunded." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن تُصدر شهادة جديدة بعد انتهاء الصلاحية لأنه تم استرداد مبلغ هذه العملية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach Ablauf wird kein neues Zertifikat ausgestellt, da dieser Kauf erstattet wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
