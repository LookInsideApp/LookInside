    "Keychain access to the license key was denied, so Pro features are paused." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم رفض وصول سلسلة المفاتيح إلى مفتاح الترخيص، لذا تم إيقاف ميزات Pro مؤقتًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlüsselbundzugriff auf den Lizenzschlüssel wurde verweigert. Pro-Funktionen sind pausiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keychain access to the license key was denied, so Pro features are paused."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se denegó el acceso del llavero a la clave de licencia, por lo que las funciones Pro están en pausa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès au trousseau pour la clé de licence a été refusé ; les fonctionnalités Pro sont donc suspendues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso al portachiavi per la chiave di licenza è stato negato, quindi le funzioni Pro sono in pausa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライセンスキーへのキーチェーンアクセスが拒否されたため、Pro機能は停止しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이선스 키에 대한 키체인 접근이 거부되어 Pro 기능이 일시 중지되었습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à chave de licença foi negado pelo Acesso às Chaves, então os recursos Pro estão pausados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к ключу лицензии в связке ключей отклонён, поэтому функции Pro приостановлены."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyền truy cập chuỗi khóa cho khóa giấy phép đã bị từ chối nên các tính năng Pro đang tạm dừng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "钥匙串拒绝了对许可证密钥的访问，Pro 功能已暂停。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鑰匙圈拒絕存取授權碼，Pro 功能已暫停。"
          }
        }
      }
    },
