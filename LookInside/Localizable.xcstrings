            "value" : "Los controles nativos no se inspeccionan en esta plataforma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les contrôles natifs ne sont pas inspectés sur cette plateforme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I controlli nativi non vengono ispezionati su questa piattaforma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプラットフォームでは、ネイティブコントロールは検査されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 플랫폼에서는 네이티브 컨트롤을 검사하지 않습니다."
          }
        },
        "pt-BR" : {
