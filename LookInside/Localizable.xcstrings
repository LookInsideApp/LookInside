    "This object is not in the current hierarchy — it may have been released, filtered out, or come from data captured before it had an identity." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا الكائن غير موجود في التسلسل الهرمي الحالي؛ ربما تم تحريره أو استبعاده بالتصفية، أو أنه من بيانات الْتُقطت قبل أن يصبح له معرّف."
          }
        },
        "de" : {
