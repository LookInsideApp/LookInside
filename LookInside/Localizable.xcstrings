    "It may be due to changes in the layer structure within the iOS app. You can try reloading the entire structure in LookInside." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يكون السبب تغيّرًا في بنية الطبقات داخل تطبيق iOS. يمكنك محاولة إعادة تحميل البنية بالكامل في LookInside."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möglicherweise hat sich die Ebenenstruktur in der iOS-App geändert. Versuche, die gesamte Struktur in LookInside neu zu laden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It may be due to changes in the layer structure within the iOS app. You can try reloading the entire structure in LookInside."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede deberse a cambios en la estructura de capas de la app de iOS. Prueba a recargar toda la estructura en LookInside."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela peut être dû à des changements dans la structure des calques de l’app iOS. Essayez de recharger toute la structure dans LookInside."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrebbe dipendere da modifiche alla struttura dei livelli nell’app iOS. Prova a ricaricare l’intera struttura in LookInside."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS App内のレイヤー構造が変更された可能性があります。LookInsideで構造全体を再読み込みしてみてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 앱의 레이어 구조가 바뀌었기 때문일 수 있습니다. LookInside에서 전체 구조를 다시 불러와 보세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso pode ocorrer por mudanças na estrutura de camadas dentro do app iOS. Tente recarregar toda a estrutura no LookInside."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возможно, структура слоёв в приложении iOS изменилась. Попробуйте обновить всю структуру в LookInside."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có thể do cấu trúc lớp bên trong ứng dụng iOS đã thay đổi. Bạn có thể thử tải lại toàn bộ cấu trúc trong LookInside."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这可能是因为 iOS App 内部的图层结构发生了变化。你可以尝试在 LookInside 中重新载入整个结构。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這可能是因為 iOS App 內部的圖層結構已變更。你可以嘗試在 LookInside 中重新載入整個結構。"
          }
        }
      }
    },
