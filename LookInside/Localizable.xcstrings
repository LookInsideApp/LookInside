    "LookInside Server framework is signed by a different team.\nExpected: %1$@\nFound: %2$@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم توقيع إطار LookInside Server بواسطة فريق مختلف.\nالمتوقع: %1$@\nالموجود: %2$@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das LookInside Server Framework ist von einem anderen Team signiert.\nErwartet: %1$@\nGefunden: %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside Server framework is signed by a different team.\nExpected: %1$@\nFound: %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El framework de LookInside Server está firmado por otro equipo.\nEsperado: %1$@\nEncontrado: %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le framework LookInside Server est signé par une autre équipe.\nAttendu : %1$@\nTrouvé : %2$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il framework LookInside Server è firmato da un team diverso.\nAtteso: %1$@\nTrovato: %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside Serverフレームワークが別のチームによって署名されています。\n想定: %1$@\n実際: %2$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside Server 프레임워크가 다른 팀으로 서명되었습니다.\n예상: %1$@\n확인됨: %2$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O framework do LookInside Server está assinado por outra equipe.\nEsperado: %1$@\nEncontrado: %2$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фреймворк LookInside Server подписан другой командой.\nОжидалось: %1$@\nНайдено: %2$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside Server framework được ký bởi một nhóm khác.\nDự kiến: %1$@\nTìm thấy: %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside Server framework 由其他团队签名。\n期望：%1$@\n实际：%2$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside Server framework 由其他團隊簽署。\n預期：%1$@\n實際：%2$@"
