    "Nested interaction shapes use dashed bounds when their combined path is unavailable." : {
      "comment" : "Node detail note",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم أشكال التفاعل المتداخلة حدودًا متقطعة عندما يتعذر الحصول على مسارها المدمج."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschachtelte Interaktionsformen verwenden gestrichelte Grenzen, wenn ihr kombinierter Pfad nicht verfügbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nested interaction shapes use dashed bounds when their combined path is unavailable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las formas de interacción anidadas usan límites discontinuos cuando no se dispone de su trazado combinado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les formes d’interaction imbriquées utilisent des limites en pointillés lorsque leur tracé combiné n’est pas disponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le forme di interazione annidate usano limiti tratteggiati quando il percorso combinato non è disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入れ子のインタラクションシェイプは、結合したパスを取得できない場合、破線の境界で表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "결합된 경로를 사용할 수 없으면 중첩된 상호작용 셰이프는 점선 bounds로 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formas de interação aninhadas usam limites tracejados quando o caminho combinado não está disponível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вложенные формы взаимодействия показываются пунктирными границами, если их общий контур недоступен."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các hình dạng tương tác lồng nhau dùng giới hạn nét đứt khi không có đường dẫn kết hợp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当组合路径不可用时，嵌套的交互形状使用虚线边界。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當無法取得巢狀互動形狀的合併路徑時，會以虛線邊界表示。"
          }
        }
      }
    },
