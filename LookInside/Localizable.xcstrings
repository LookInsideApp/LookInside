    "You can click \"Pause\" button near the bottom-left corner in Xcode to pause your iOS app, and input in Xcode console like the contents below:\nexpr [((%@ *)%@) %@]" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك النقر على زر “Pause” بالقرب من الزاوية السفلية اليسرى في Xcode لإيقاف تطبيق iOS مؤقتًا، ثم إدخال المحتوى التالي في وحدة تحكم Xcode:\nexpr [((%1$@ *)%2$@) %3$@]"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke in Xcode unten links auf „Pause“, um deine iOS-App anzuhalten, und gib in der Xcode-Konsole Folgendes ein:\nexpr [((%1$@ *)%2$@) %3$@]"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can click \"Pause\" button near the bottom-left corner in Xcode to pause your iOS app, and input in Xcode console like the contents below:\nexpr [((%1$@ *)%2$@) %3$@]"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes hacer clic en el botón “Pause” cerca de la esquina inferior izquierda de Xcode para pausar tu app de iOS e introducir en la consola de Xcode algo como lo siguiente:\nexpr [((%1$@ *)%2$@) %3$@]"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez cliquer sur le bouton « Pause » en bas à gauche dans Xcode pour mettre votre app iOS en pause, puis saisir dans la console Xcode ce qui suit :\nexpr [((%1$@ *)%2$@) %3$@]"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi fare clic sul pulsante \"Pausa\" in basso a sinistra in Xcode per mettere in pausa la tua app iOS e digitare nella console di Xcode un comando come questo:\nexpr [((%1$@ *)%2$@) %3$@]"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcodeの左下付近にある“Pause”ボタンをクリックしてiOS Appを一時停止し、Xcodeのコンソールに次の内容を入力できます。\nexpr [((%1$@ *)%2$@) %3$@]"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xcode 왼쪽 아래의 \"일시 정지\" 버튼을 클릭하여 iOS 앱을 일시 정지한 다음, Xcode 콘솔에 아래 내용을 입력할 수 있습니다.\nexpr [((%1$@ *)%2$@) %3$@]"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode clicar no botão \"Pause\" perto do canto inferior esquerdo do Xcode para pausar seu app iOS e digitar no console do Xcode algo como o conteúdo abaixo:\nexpr [((%1$@ *)%2$@) %3$@]"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите кнопку «Pause» в левом нижнем углу Xcode, чтобы приостановить приложение iOS, и введите в консоли Xcode следующее:\nexpr [((%1$@ *)%2$@) %3$@]"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể nhấp nút \"Pause\" gần góc dưới bên trái của Xcode để tạm dừng ứng dụng iOS, rồi nhập vào bảng điều khiển Xcode nội dung như bên dưới:\nexpr [((%1$@ *)%2$@) %3$@]"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以点按 Xcode 左下角附近的“Pause”按钮，让 iOS App 暂停，然后在 Xcode 控制台中输入如下内容：\nexpr [((%1$@ *)%2$@) %3$@]"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以點按 Xcode 左下角附近的「Pause」按鈕，讓 iOS App 暫停，然後在 Xcode 主控台輸入以下內容：\nexpr [((%1$@ *)%2$@) %3$@]"
          }
        }
      }
    },
    "You must connect LookInside with target iOS app before using this feature." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
