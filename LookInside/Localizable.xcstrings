    "Fast refresh mode is enabled, which may result in layer consistency issues." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وضع التحديث السريع مفعّل، وقد يتسبب في عدم اتساق الطبقات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der schnelle Aktualisierungsmodus ist aktiviert. Dadurch kann es zu Inkonsistenzen bei Ebenen kommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast refresh mode is enabled, which may result in layer consistency issues."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo de actualización rápida está activado y puede provocar incoherencias entre capas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode d’actualisation rapide est activé, ce qui peut entraîner des incohérences entre les calques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità di aggiornamento rapido è attiva e può causare incongruenze nei livelli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高速更新モードが有効です。レイヤーの整合性に問題が生じる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빠른 새로 고침 모드가 켜져 있어 레이어 일관성 문제가 생길 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo de atualização rápida está ativado e pode causar inconsistências nas camadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включён режим быстрого обновления, это может нарушить согласованность слоёв."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chế độ làm mới nhanh đang bật, có thể gây ra sự không nhất quán giữa các lớp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
