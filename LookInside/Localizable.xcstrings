          "stringUnit" : {
            "state" : "translated",
            "value" : "to measure between it and selected %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "para medir la distancia entre ella y el %@ seleccionado."
          }
        },
