    "Detail synchronization is still running. Wait for it to finish before reloading." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مزامنة التفاصيل لا تزال قيد التشغيل. انتظر حتى تنتهي قبل إعادة التحميل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Detailsynchronisierung läuft noch. Warte, bis sie abgeschlossen ist, bevor du neu lädst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización de detalles aún está en curso. Espera a que termine antes de recargar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation des détails est toujours en cours. Attendez qu’elle se termine avant de recharger."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronizzazione dei dettagli è ancora in corso. Attendi il completamento prima di ricaricare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "詳細の同期がまだ実行中です。完了してから再読み込みしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세부 정보 동기화가 아직 진행 중입니다. 끝날 때까지 기다린 후 다시 불러오세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização dos detalhes ainda está em andamento. Aguarde a conclusão antes de recarregar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизация подробностей ещё выполняется. Дождитесь её завершения перед обновлением."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc đồng bộ chi tiết vẫn đang chạy. Hãy đợi hoàn tất rồi mới tải lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
