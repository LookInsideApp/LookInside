    "Perhaps the related object was deallocated. You can reload LookInside to get newest data." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ربما تم تحرير الكائن ذي الصلة من الذاكرة. يمكنك إعادة تحميل LookInside للحصول على أحدث البيانات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möglicherweise wurde das zugehörige Objekt freigegeben. Lade LookInside neu, um die aktuellen Daten zu erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps the related object was deallocated. You can reload LookInside to get newest data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizá el objeto relacionado se haya liberado. Recarga LookInside para obtener los datos más recientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’objet associé a peut-être été désalloué. Vous pouvez recharger LookInside pour obtenir les données les plus récentes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’oggetto correlato potrebbe essere stato deallocato. Ricarica LookInside per ottenere i dati più recenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "関連するオブジェクトが解放された可能性があります。LookInsideを再読み込みすると最新のデータを取得できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관련 객체가 해제되었을 수 있습니다. LookInside를 다시 불러와 최신 데이터를 가져오세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O objeto relacionado pode ter sido desalocado. Recarregue o LookInside para obter os dados mais recentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возможно, связанный объект был освобождён. Обновите LookInside, чтобы получить актуальные данные."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có thể đối tượng liên quan đã bị giải phóng. Bạn có thể tải lại LookInside để lấy dữ liệu mới nhất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相关对象可能已经释放。你可以重新载入 LookInside 以获取最新数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相關物件可能已被釋放。你可以重新載入 LookInside 以取得最新資料。"
          }
        }
      }
    },
    "Perhaps your iOS app is paused with breakpoint in Xcode, blocked by other tasks in main thread, or moved to background state." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ربما تم إيقاف تطبيق iOS مؤقتًا عند نقطة توقف في Xcode، أو تعطّل بسبب مهام أخرى في الخيط الرئيسي، أو انتقل إلى الخلفية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möglicherweise ist deine iOS-App in Xcode an einem Breakpoint angehalten, wird durch andere Aufgaben im Hauptthread blockiert oder befindet sich im Hintergrund."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps your iOS app is paused with breakpoint in Xcode, blocked by other tasks in main thread, or moved to background state."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizá tu app de iOS esté en pausa por un punto de interrupción en Xcode, bloqueada por otras tareas del hilo principal o en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre app iOS est peut-être en pause sur un point d’arrêt dans Xcode, bloquée par d’autres tâches sur le thread principal ou passée en arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse la tua app iOS è in pausa su un breakpoint in Xcode, è bloccata da altre attività nel thread principale o è passata in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS AppがXcodeのブレークポイントで停止しているか、メインスレッドの別のタスクでブロックされているか、バックグラウンドに移行した可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 앱이 Xcode에서 중단점으로 일시 정지되었거나, 메인 스레드가 다른 작업에 막혀 있거나, 백그라운드로 이동했을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu app iOS pode estar pausado por um breakpoint no Xcode, bloqueado por outras tarefas na thread principal ou em segundo plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возможно, ваше приложение iOS приостановлено на точке останова в Xcode, заблокировано другими задачами в основном потоке или перешло в фоновый режим."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có thể ứng dụng iOS của bạn đang tạm dừng ở điểm ngắt trong Xcode, bị tác vụ khác chặn trên luồng chính, hoặc đã chuyển xuống nền."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 iOS App 可能因 Xcode 断点而暂停，或被主线程中的其他任务阻塞，也可能已经切到后台。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 iOS App 可能因 Xcode 中斷點而暫停，或被主執行緒中的其他工作阻擋，也可能已切到背景。"
          }
        }
      }
    },
    "Perhaps your iOS app is paused with breakpoint in Xcode, blocked by other tasks in main thread, or moved to background state.\nToo large screenshots may also lead to this error." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ربما تم إيقاف تطبيق iOS مؤقتًا عند نقطة توقف في Xcode، أو تعطّل بسبب مهام أخرى في الخيط الرئيسي، أو انتقل إلى الخلفية.\nقد تؤدي لقطات الشاشة الكبيرة جدًا إلى هذا الخطأ أيضًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möglicherweise ist deine iOS-App in Xcode an einem Breakpoint angehalten, wird durch andere Aufgaben im Hauptthread blockiert oder befindet sich im Hintergrund.\nAuch zu große Bildschirmfotos können diesen Fehler verursachen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perhaps your iOS app is paused with breakpoint in Xcode, blocked by other tasks in main thread, or moved to background state.\nToo large screenshots may also lead to this error."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quizá tu app de iOS esté en pausa por un punto de interrupción en Xcode, bloqueada por otras tareas del hilo principal o en segundo plano.\nLas capturas de pantalla demasiado grandes también pueden causar este error."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre app iOS est peut-être en pause sur un point d’arrêt dans Xcode, bloquée par d’autres tâches sur le thread principal ou passée en arrière-plan.\nDes captures d’écran trop volumineuses peuvent aussi provoquer cette erreur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse la tua app iOS è in pausa su un breakpoint in Xcode, è bloccata da altre attività nel thread principale o è passata in background.\nPotrebbe dipendere anche da screenshot troppo grandi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS AppがXcodeのブレークポイントで停止しているか、メインスレッドの別のタスクでブロックされているか、バックグラウンドに移行した可能性があります。\nスクリーンショットが大きすぎる場合も、このエラーが発生することがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 앱이 Xcode에서 중단점으로 일시 정지되었거나, 메인 스레드가 다른 작업에 막혀 있거나, 백그라운드로 이동했을 수 있습니다.\n스크린샷이 너무 크면 이 오류가 발생할 수도 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu app iOS pode estar pausado por um breakpoint no Xcode, bloqueado por outras tarefas na thread principal ou em segundo plano.\nCapturas de tela muito grandes também podem causar este erro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возможно, ваше приложение iOS приостановлено на точке останова в Xcode, заблокировано другими задачами в основном потоке или перешло в фоновый режим.\nЭту ошибку также может вызвать слишком большой снимок экрана."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có thể ứng dụng iOS của bạn đang tạm dừng ở điểm ngắt trong Xcode, bị tác vụ khác chặn trên luồng chính, hoặc đã chuyển xuống nền.\nẢnh chụp màn hình quá lớn cũng có thể gây ra lỗi này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 iOS App 可能因 Xcode 断点而暂停，或被主线程中的其他任务阻塞，也可能已经切到后台。\n截图过大也可能导致此错误。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 iOS App 可能因 Xcode 中斷點而暫停，或被主執行緒中的其他工作阻擋，也可能已切到背景。\n截圖過大也可能導致此錯誤。"
          }
        }
      }
    },
    "Please update the embedded LookinServer integration in your target app to a newer version from this repository." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدّث تكامل LookinServer المضمّن في التطبيق الهدف إلى إصدار أحدث من هذا المستودع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisiere die eingebettete LookinServer-Integration in deiner Ziel-App auf eine neuere Version aus diesem Repository."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please update the embedded LookinServer integration in your target app to a newer version from this repository."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualiza la integración incrustada de LookinServer en tu app de destino a una versión más reciente de este repositorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez à jour l’intégration LookinServer embarquée dans votre app cible vers une version plus récente de ce dépôt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiorna l’integrazione di LookinServer incorporata nell’app di destinazione a una versione più recente di questo repository."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターゲットAppに組み込まれているLookinServerを、このリポジトリの新しいバージョンに更新してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대상 앱에 내장된 LookinServer 통합을 이 저장소의 최신 버전으로 업데이트하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualize a integração do LookinServer embutida no seu app de destino para uma versão mais recente deste repositório."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновите встроенную интеграцию LookinServer в целевом приложении до новой версии из этого репозитория."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy cập nhật tích hợp LookinServer trong ứng dụng đích lên phiên bản mới hơn từ kho lưu trữ này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请将目标 App 中集成的 LookinServer 更新为此仓库中的较新版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請將目標 App 中整合的 LookinServer 更新為此儲存庫中的較新版本。"
          }
        }
      }
    },
    "Please upgrade the LookinServer SDK version in your iOS project to 1.2.7 or higher." : {
      "localizations" : {
