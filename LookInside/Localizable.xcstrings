          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang chờ các vùng tương tác hiện tại. Server cũ hơn cần cập nhật để đưa ra Gợi ý."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
