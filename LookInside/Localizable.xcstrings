          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цвет будет отображаться в формате (255, 12, 34, 0.5). Значение альфа-канала от 0 до 1."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Màu sẽ hiển thị theo dạng như (255, 12, 34, 0.5). Giá trị alpha nằm trong khoảng từ 0 đến 1."
          }
        },
        "zh-Hans" : {
