    "Please wait until current sync is completed. You can get sync progress in the upper-left corner of this window." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتظر حتى تكتمل المزامنة الحالية. يمكنك متابعة تقدم المزامنة في الزاوية العلوية اليسرى من هذه النافذة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warte, bis die aktuelle Synchronisierung abgeschlossen ist. Den Fortschritt siehst du oben links in diesem Fenster."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please wait until current sync is completed. You can get sync progress in the upper-left corner of this window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espera a que termine la sincronización actual. Puedes ver su progreso en la esquina superior izquierda de esta ventana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendez la fin de la synchronisation en cours. Sa progression s’affiche en haut à gauche de cette fenêtre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendi il completamento della sincronizzazione in corso. Puoi seguirne l’avanzamento nell’angolo in alto a sinistra di questa finestra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の同期が完了するまでお待ちください。同期の進行状況は、このウインドウの左上で確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 동기화가 끝날 때까지 기다려 주세요. 동기화 진행 상황은 이 윈도우의 왼쪽 상단에서 확인할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguarde a conclusão da sincronização atual. O progresso aparece no canto superior esquerdo desta janela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дождитесь завершения текущей синхронизации. Ход синхронизации отображается в левом верхнем углу этого окна."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy đợi đến khi quá trình đồng bộ hiện tại hoàn tất. Bạn có thể xem tiến trình đồng bộ ở góc trên bên trái của cửa sổ này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请等待当前同步完成。你可以在窗口左上角查看同步进度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請等待目前的同步完成。你可以在此視窗左上角查看同步進度。"
          }
        }
      }
    },
