    "Measured from the reported %@ content shape and its bounds." : {
      "comment" : "Suggestion detail note; %@ is a shape kind",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم القياس من شكل المحتوى %@ المُبلَّغ عنه وحدوده."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemessen anhand der gemeldeten %@-Inhaltsform und ihrer Grenzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Measured from the reported %@ content shape and its bounds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medido a partir de la forma de contenido %@ informada y sus límites."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesuré à partir de la forme de contenu %@ signalée et de ses limites."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misurato dalla forma del contenuto %@ segnalata e dai suoi limiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "報告された%@のコンテンツシェイプとその境界から測定しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보고된 %@ 콘텐츠 셰이프와 해당 bounds에서 측정한 값입니다."
