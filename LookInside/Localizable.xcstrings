    "The document was created by a LookInside app with too old version. Current LookInside app version is %@, but the document version is %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُنشئ المستند بواسطة إصدار قديم جدًا من تطبيق LookInside. إصدار تطبيق LookInside الحالي هو %1$@، بينما إصدار المستند هو %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Dokument wurde mit einer zu alten Version von LookInside erstellt. App-Version: %1$@, Dokumentversion: %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The document was created by a LookInside app with too old version. Current LookInside app version is %1$@, but the document version is %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El documento lo creó una versión demasiado antigua de LookInside. La versión actual es %1$@, pero la del documento es %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le document a été créé par une version de LookInside trop ancienne. La version actuelle est %1$@, mais celle du document est %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il documento è stato creato con una versione di LookInside troppo vecchia. La versione corrente è %1$@, mentre quella del documento è %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この書類は、古いバージョンのLookInside Appで作成されました。現在のLookInside Appのバージョンは%1$@、書類のバージョンは%2$@です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문서가 너무 오래된 버전의 LookInside 앱에서 만들어졌습니다. 현재 LookInside 앱 버전은 %1$@이고, 문서 버전은 %2$@입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O documento foi criado por um app LookInside de versão muito antiga. A versão atual é %1$@, mas a do documento é %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
