    "Waiting for current interaction regions. Older Servers need an update to provide Suggestions." : {
      "comment" : "Gesture Debug suggestions coverage note",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في انتظار مناطق التفاعل الحالية. تحتاج الإصدارات الأقدم من Server إلى تحديث لتقديم الاقتراحات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warten auf aktuelle Interaktionsbereiche. Ältere Server müssen aktualisiert werden, um Vorschläge zu liefern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waiting for current interaction regions. Older Servers need an update to provide Suggestions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando las regiones de interacción actuales. Los Server antiguos necesitan una actualización para ofrecer sugerencias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente des zones d’interaction actuelles. Les anciens Servers doivent être mis à jour pour fournir des suggestions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In attesa delle aree di interazione correnti. I Server meno recenti devono essere aggiornati per fornire i suggerimenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のインタラクション領域を待機中です。古いServerでは、提案を表示するためにアップデートが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 상호작용 영역을 기다리는 중입니다. 이전 버전의 Server는 제안을 제공하려면 업데이트해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguardando as regiões de interação atuais. Servers mais antigos precisam ser atualizados para fornecer Sugestões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
