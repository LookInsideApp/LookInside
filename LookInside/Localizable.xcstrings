            "state" : "translated",
            "value" : "The target disconnected. Reconnect it, then start a new capture."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El destino se desconectó. Vuelve a conectarlo e inicia una captura nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cible s’est déconnectée. Reconnectez-la, puis démarrez une nouvelle capture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
