    "First-time loading of SwiftUI details may take longer because LookInside needs to collect and match SwiftUI debug data." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يستغرق تحميل تفاصيل SwiftUI أول مرة وقتًا أطول لأن LookInside يحتاج إلى جمع بيانات تصحيح SwiftUI ومطابقتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das erstmalige Laden von SwiftUI-Details kann länger dauern, da LookInside SwiftUI-Debugdaten sammeln und abgleichen muss."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First-time loading of SwiftUI details may take longer because LookInside needs to collect and match SwiftUI debug data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La primera carga de los detalles de SwiftUI puede tardar más, porque LookInside debe recopilar y comparar los datos de depuración de SwiftUI."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le premier chargement des détails SwiftUI peut prendre plus de temps, car LookInside doit collecter et faire correspondre les données de débogage SwiftUI."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il primo caricamento dei dettagli di SwiftUI può richiedere più tempo perché LookInside deve raccogliere e associare i dati di debug di SwiftUI."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInsideがSwiftUIのデバッグデータを収集して照合する必要があるため、SwiftUIの詳細の初回読み込みには時間がかかる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside가 SwiftUI 디버그 데이터를 수집하고 대조해야 하므로 SwiftUI 세부 정보를 처음 불러올 때는 시간이 더 걸릴 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O primeiro carregamento dos detalhes de SwiftUI pode demorar mais, pois o LookInside precisa coletar e relacionar os dados de depuração do SwiftUI."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Первая загрузка подробностей SwiftUI может занять больше времени: LookInside должен собрать и сопоставить отладочные данные SwiftUI."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lần đầu tải chi tiết SwiftUI có thể lâu hơn vì LookInside cần thu thập và đối chiếu dữ liệu gỡ lỗi SwiftUI."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首次载入 SwiftUI 详情时，LookInside 需要收集并匹配 SwiftUI 调试数据，可能耗时较长。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首次載入 SwiftUI 詳細資訊時，LookInside 需要收集並比對 SwiftUI 偵錯資料，可能會花較長時間。"
          }
        }
      }
    },
