          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tài liệu được tạo bởi ứng dụng LookInside có phiên bản quá cũ. Phiên bản ứng dụng LookInside hiện tại là %1$@, nhưng phiên bản tài liệu là %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
