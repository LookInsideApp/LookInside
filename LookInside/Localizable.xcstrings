    "Target app is linked with a higher version LookinServer.framework. Update this community build from the current repository source." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التطبيق الهدف مرتبط بإصدار أحدث من LookinServer.framework. حدّث هذا الإصدار المجتمعي من مصدر المستودع الحالي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ziel-App ist mit einer neueren Version von LookinServer.framework verknüpft. Aktualisiere diesen Community-Build aus dem aktuellen Repository-Quellcode."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Target app is linked with a higher version LookinServer.framework. Update this community build from the current repository source."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app de destino está enlazada con una versión más reciente de LookinServer.framework. Actualiza esta compilación comunitaria desde el código fuente actual del repositorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app cible est liée à une version plus récente de LookinServer.framework. Mettez à jour cette version communautaire à partir du code source actuel du dépôt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app di destinazione è collegata a una versione più recente di LookinServer.framework. Aggiorna questa build della community dal sorgente attuale del repository."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターゲットAppに、より新しいバージョンのLookinServer.frameworkがリンクされています。現在のリポジトリのソースから、このコミュニティ版をアップデートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대상 앱이 더 높은 버전의 LookinServer.framework에 링크되어 있습니다. 현재 저장소 소스에서 이 커뮤니티 빌드를 업데이트하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app de destino está vinculado a uma versão mais recente do LookinServer.framework. Atualize esta versão da comunidade a partir do código-fonte atual do repositório."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Целевое приложение скомпоновано с более новой версией LookinServer.framework. Обновите эту сборку сообщества из актуального исходного кода репозитория."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng đích được liên kết với phiên bản LookinServer.framework cao hơn. Hãy cập nhật bản cộng đồng này từ mã nguồn kho lưu trữ hiện tại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目标 App 链接的 LookinServer.framework 版本更高。请从当前仓库源码更新此社区版本。"
          }
