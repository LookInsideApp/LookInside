        }
      }
    },
    "LookInside could not reach an injector on %d connected device(s).\n\nInstall the LookInside Injector app on the device and open it once. It stays reachable in the background after that, until the device restarts." : {
      "comment" : "Alert body when injector is unreachable; %d is device count",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على LookInside الوصول إلى أداة حقن على %d من الأجهزة المتصلة.\n\nثبّت تطبيق LookInside Injector على الجهاز وافتحه مرة واحدة. يظل متاحًا في الخلفية بعد ذلك إلى أن يُعاد تشغيل الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside konnte auf %d verbundenen Geräten keinen Injector erreichen.\n\nInstalliere die App „LookInside Injector“ auf dem Gerät und öffne sie einmalig. Danach bleibt sie im Hintergrund erreichbar, bis das Gerät neu startet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside could not reach an injector on %d connected device(s).\n\nInstall the LookInside Injector app on the device and open it once. It stays reachable in the background after that, until the device restarts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside no pudo conectar con un inyector en %d dispositivo(s) conectado(s).\n\nInstala la app LookInside Injector en el dispositivo y ábrela una vez. Después seguirá disponible en segundo plano hasta que se reinicie el dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside n’a pas pu joindre d’injecteur sur %d appareil(s) connecté(s).\n\nInstallez l’app LookInside Injector sur l’appareil et ouvrez-la une fois. Elle reste ensuite joignable en arrière-plan jusqu’au redémarrage de l’appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside non è riuscito a raggiungere un injector su %d dispositivi connessi.\n\nInstalla l’app LookInside Injector sul dispositivo e aprila una volta. Resterà raggiungibile in background fino al riavvio del dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続中の%d台のデバイスで、インジェクタに接続できませんでした。\n\nデバイスにLookInside Injector Appをインストールして、一度開いてください。その後、デバイスを再起動するまでバックグラウンドで接続可能な状態が続きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결된 기기 %d대의 인젝터에 연결할 수 없습니다.\n\n기기에 LookInside Injector 앱을 설치하고 한 번 여세요. 이후에는 기기를 다시 시작할 때까지 백그라운드에서 계속 사용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O LookInside não conseguiu se comunicar com um injetor em %d dispositivo(s) conectado(s).\n\nInstale o app LookInside Injector no dispositivo e abra-o uma vez. Depois disso, ele continua disponível em segundo plano até o dispositivo ser reiniciado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside не удалось связаться с инжектором на подключённых устройствах: %d.\n\nУстановите приложение LookInside Injector на устройство и один раз откройте его. После этого оно остаётся доступным в фоне до перезагрузки устройства."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside không kết nối được với injector trên %d thiết bị đang kết nối.\n\nHãy cài ứng dụng LookInside Injector lên thiết bị và mở một lần. Sau đó nó vẫn khả dụng ở nền cho đến khi thiết bị khởi động lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside 无法连接到 %d 台已连接设备上的注入器。\n\n请在设备上安装 LookInside Injector App 并打开一次。此后它会在后台保持可连接，直到设备重启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside 無法連接 %d 部已連接裝置上的注入器。\n\n請在裝置上安裝 LookInside 注入器 App 並開啟一次。之後它會留在背景，直到裝置重新啟動。"
          }
        }
      }
    },
    "LookInside could not reach the injector on that device. Open the LookInside Injector app on the device once — it stays available in the background afterwards, until the device restarts." : {
      "comment" : "Device injection error: cannot connect to injector",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على LookInside الوصول إلى أداة الحقن على ذلك الجهاز. افتح تطبيق LookInside Injector على الجهاز مرة واحدة؛ يظل متاحًا في الخلفية بعد ذلك إلى أن يُعاد تشغيل الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside konnte den Injector auf diesem Gerät nicht erreichen. Öffne die App „LookInside Injector“ einmalig auf dem Gerät. Danach bleibt sie im Hintergrund verfügbar, bis das Gerät neu startet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside could not reach the injector on that device. Open the LookInside Injector app on the device once — it stays available in the background afterwards, until the device restarts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside no pudo conectar con el inyector de ese dispositivo. Abre una vez la app LookInside Injector en el dispositivo: después seguirá disponible en segundo plano hasta que se reinicie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside n’a pas pu joindre l’injecteur sur cet appareil. Ouvrez une fois l’app LookInside Injector sur l’appareil ; elle reste ensuite disponible en arrière-plan jusqu’au redémarrage de l’appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside non è riuscito a raggiungere l’injector su quel dispositivo. Apri una volta l’app LookInside Injector sul dispositivo: resterà disponibile in background fino al riavvio del dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInsideがそのデバイスのインジェクタに接続できませんでした。デバイスでLookInside Injector Appを一度開いてください。その後、デバイスを再起動するまでバックグラウンドで利用可能な状態が続きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside가 해당 기기의 인젝터에 연결할 수 없습니다. 기기에서 LookInside Injector 앱을 한 번 여세요. 이후에는 기기를 다시 시작할 때까지 백그라운드에서 계속 사용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O LookInside não conseguiu se comunicar com o injetor nesse dispositivo. Abra o app LookInside Injector no dispositivo uma vez. Depois disso, ele continua disponível em segundo plano até o dispositivo ser reiniciado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside не удалось связаться с инжектором на этом устройстве. Один раз откройте на устройстве приложение LookInside Injector — после этого оно остаётся доступным в фоне до перезагрузки устройства."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside không kết nối được với injector trên thiết bị đó. Hãy mở ứng dụng LookInside Injector trên thiết bị một lần. Sau đó nó vẫn khả dụng ở nền cho đến khi thiết bị khởi động lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside 无法连接到该设备上的注入器。请在设备上打开一次 LookInside Injector App，此后它会在后台保持可用，直到设备重启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside 無法連接該裝置上的注入器。請在裝置上開啟一次 LookInside 注入器 App，之後它會留在背景，直到裝置重新啟動。"
          }
        }
      }
    },
    "LookInside doesn't support invoking methods with arguments yet." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يدعم LookInside استدعاء الدوال ذات المعاملات حتى الآن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside unterstützt das Aufrufen von Methoden mit Argumenten noch nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside doesn't support invoking methods with arguments yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside aún no admite invocar métodos con argumentos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside ne prend pas encore en charge l’appel de méthodes avec arguments."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside non supporta ancora la chiamata di metodi con argomenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInsideは、引数付きメソッドの呼び出しにはまだ対応していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside는 아직 인수가 있는 메서드 호출을 지원하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O LookInside ainda não permite chamar métodos com argumentos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside пока не поддерживает вызов методов с аргументами."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside chưa hỗ trợ gọi phương thức có đối số."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside 暂不支持调用带参数的方法。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside 尚不支援呼叫帶有引數的方法。"
          }
        }
      }
    },
    "LookInside doesn't support this syntax yet. Please input a method or property name." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يدعم LookInside هذه الصياغة حتى الآن. أدخل اسم دالة أو خاصية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside unterstützt diese Syntax noch nicht. Gib einen Methoden- oder Eigenschaftsnamen ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside doesn't support this syntax yet. Please input a method or property name."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside aún no admite esta sintaxis. Introduce el nombre de un método o una propiedad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside ne prend pas encore en charge cette syntaxe. Saisissez un nom de méthode ou de propriété."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside non supporta ancora questa sintassi. Inserisci il nome di un metodo o di una proprietà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInsideはこの構文にはまだ対応していません。メソッド名またはプロパティ名を入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside는 아직 이 구문을 지원하지 않습니다. 메서드 또는 속성 이름을 입력하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O LookInside ainda não oferece suporte a esta sintaxe. Informe o nome de um método ou de uma propriedade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside пока не поддерживает этот синтаксис. Введите имя метода или свойства."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside chưa hỗ trợ cú pháp này. Hãy nhập tên phương thức hoặc thuộc tính."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LookInside 暂不支持这种语法。请输入方法名或属性名。"
          }
