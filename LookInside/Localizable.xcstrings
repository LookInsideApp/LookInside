    "Connect an iPhone or iPad over USB, trust this Mac on the device, and try again." : {
      "comment" : "Alert body when no device is connected",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصّل iPhone أو iPad عبر USB، وثِق بهذا الـ Mac على الجهاز، ثم حاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde ein iPhone oder iPad per USB, vertraue diesem Mac auf dem Gerät und versuche es noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect an iPhone or iPad over USB, trust this Mac on the device, and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta un iPhone o iPad por USB, confía en este Mac en el dispositivo y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez un iPhone ou un iPad par USB, faites confiance à ce Mac sur l’appareil, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega un iPhone o iPad tramite USB, autorizza questo Mac sul dispositivo e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneまたはiPadをUSBで接続し、デバイスでこのMacを信頼してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB로 iPhone 또는 iPad를 연결하고, 기기에서 이 Mac을 신뢰한 다음 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte um iPhone ou iPad por USB, confie neste Mac no dispositivo e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключите iPhone или iPad по USB, доверьтесь этому Mac на устройстве и повторите попытку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối iPhone hoặc iPad qua USB, tin cậy Mac này trên thiết bị rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请通过 USB 连接 iPhone 或 iPad，在设备上信任这台 Mac，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請以 USB 連接 iPhone 或 iPad，在裝置上信任這部 Mac，然後再試一次。"
          }
        }
      }
    },
