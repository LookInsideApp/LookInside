    "The target disconnected. Reconnect it, then start a new capture." : {
      "comment" : "Gesture Debug status message",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقطع اتصال الهدف. أعد الاتصال به، ثم ابدأ التقاطًا جديدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
