    "Current LookInside app is too old to open this document. Current LookInside app version is %@, but the document version is %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطبيق LookInside الحالي قديم جدًا لفتح هذا المستند. إصدار تطبيق LookInside الحالي هو %1$@، بينما إصدار المستند هو %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die installierte LookInside-App ist zu alt, um dieses Dokument zu öffnen. App-Version: %1$@, Dokumentversion: %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Current LookInside app is too old to open this document. Current LookInside app version is %1$@, but the document version is %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión de LookInside es demasiado antigua para abrir este documento. La versión actual es %1$@, pero la del documento es %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version de LookInside est trop ancienne pour ouvrir ce document. La version actuelle est %1$@, mais celle du document est %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa versione di LookInside è troppo vecchia per aprire il documento. La versione corrente è %1$@, mentre quella del documento è %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のLookInside Appのバージョンが古いため、この書類を開けません。現在のバージョンは%1$@、書類のバージョンは%2$@です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 LookInside 앱이 너무 오래되어 이 문서를 열 수 없습니다. 현재 LookInside 앱 버전은 %1$@이고, 문서 버전은 %2$@입니다."
          }
        },
