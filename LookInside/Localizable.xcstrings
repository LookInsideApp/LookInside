    "Could not confirm capture stopped: %@. Disconnect the target to end capture." : {
      "comment" : "Gesture Debug status; %@ is the error description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر التأكد من توقف الالتقاط: %@. افصل الهدف لإنهاء الالتقاط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Stoppen der Aufnahme konnte nicht bestätigt werden: %@. Trenne das Ziel, um die Aufnahme zu beenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not confirm capture stopped: %@. Disconnect the target to end capture."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo confirmar que la captura se detuviera: %@. Desconecta el destino para finalizarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de confirmer l’arrêt de la capture : %@. Déconnectez la cible pour terminer la capture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile confermare l’interruzione della cattura: %@. Disconnetti la destinazione per terminarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャプチャの停止を確認できませんでした: %@。キャプチャを終了するには、ターゲットとの接続を切断してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캡처가 중지되었는지 확인할 수 없습니다: %@. 캡처를 끝내려면 대상의 연결을 끊으세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível confirmar a interrupção da captura: %@. Desconecte o destino para encerrar a captura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось подтвердить остановку захвата: %@. Отключите цель, чтобы завершить захват."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không xác nhận được việc dừng ghi: %@. Hãy ngắt kết nối đích để kết thúc ghi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法确认捕获已停止：%@。请断开目标连接以结束捕获。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法確認擷取已停止：%@。請中斷目標連線以結束擷取。"
          }
        }
      }
    },
