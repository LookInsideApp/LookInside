    "Color will be displayed in format like (255, 12, 34, 0.5). Alpha value is between 0 and 1." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم عرض اللون بتنسيق مثل (255, 12, 34, 0.5). قيمة ألفا بين 0 و1."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Farbe wird in einem Format wie (255, 12, 34, 0.5) angezeigt. Der Alphawert liegt zwischen 0 und 1."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Color will be displayed in format like (255, 12, 34, 0.5). Alpha value is between 0 and 1."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El color se mostrará en un formato como (255, 12, 34, 0.5). El valor alfa está entre 0 y 1."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les couleurs seront affichées au format (255, 12, 34, 0.5). La valeur alpha est comprise entre 0 et 1."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il colore verrà mostrato in un formato come (255, 12, 34, 0.5). Il valore alpha è compreso tra 0 e 1."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "色を(255, 12, 34, 0.5)のような形式で表示します。アルファ値は0〜1です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "색상이 (255, 12, 34, 0.5)와 같은 형식으로 표시됩니다. 알파 값은 0에서 1 사이입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
